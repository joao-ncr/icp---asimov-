# Banco e cache
DB_PATH=data/asimov.db
CACHE_DIR=data/cache

# IA local (opcional). O modo heuristic nao exige Ollama.
LLM_BACKEND=heuristic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embeddings: tfidf e o caminho leve. st exige sentence-transformers.
EMBEDDING_BACKEND=tfidf
ST_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Descoberta opcional via SearXNG
SEARXNG_URL=

# Crawler
CRAWLER_USER_AGENT=AsimovProspectorBot/1.0 (+contato: comercial@asimovjr.com.br)
MAX_PAGES_PER_DOMAIN=8
MAX_RESPONSE_BYTES=2000000
CRAWL_TIMEOUT_S=12
DOMAIN_DELAY_S=1.5
CACHE_TTL_DAYS=14
RETENTION_DAYS=90
